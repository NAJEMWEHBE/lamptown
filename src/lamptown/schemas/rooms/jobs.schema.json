{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamptown.invalid/schemas/rooms/jobs.schema.json",
  "title": "Lamptown room: jobs (clock tower)",
  "description": "Scheduled jobs: one window and one trumpet per row (8 at most, then '+N'). A row in state 'working' rings the bell; the clock's plaque shows the soonest 'next'. A missed run (last run older than its period + 15 %) is the collector's call and shows as 'error' with why 'missed'.",
  "type": "object",
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "$ref": "#/$defs/state"
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "error": {
      "type": "string",
      "maxLength": 300
    },
    "num": {
      "type": [
        "string",
        "integer"
      ],
      "description": "Optional: the number on the building's name plate."
    },
    "updated": {
      "$ref": "#/$defs/time"
    },
    "needs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "name",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "schedule": {
            "type": "string",
            "maxLength": 120
          },
          "next": {
            "$ref": "#/$defs/time"
          },
          "last": {
            "$ref": "#/$defs/time"
          },
          "state": {
            "$ref": "#/$defs/state"
          },
          "result": {
            "type": "string",
            "maxLength": 300
          },
          "href": {
            "type": "string",
            "maxLength": 2048
          },
          "feeds": {
            "type": "string",
            "maxLength": 40,
            "description": "Optional building id this job feeds; while it runs a spark flies to that building."
          },
          "why": {
            "type": "string",
            "maxLength": 40,
            "description": "Which case of the state this is (for example 'missed', 'stopped', 'never')."
          },
          "short": {
            "type": "string",
            "maxLength": 16,
            "description": "Optional slate name (the pixel font is upper case)."
          },
          "when": {
            "type": "string",
            "maxLength": 120,
            "description": "The schedule in plain words ('Tuesdays 07:15')."
          },
          "when_short": {
            "type": "string",
            "maxLength": 40,
            "description": "The schedule for a chalk slate ('EVERY TUE 07:15')."
          },
          "colour": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Optional banner colour for the job's trumpet."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "state": {
      "type": "string",
      "enum": [
        "ok",
        "waiting",
        "working",
        "error",
        "missing"
      ]
    },
    "time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Absolute ISO 8601 time with an offset; the page writes 'in 3 h' itself."
    },
    "need": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "href": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "href": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  }
}
