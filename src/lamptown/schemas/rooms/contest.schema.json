{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamptown.invalid/schemas/rooms/contest.schema.json",
  "title": "Lamptown room: contest (idea contest)",
  "description": "One idea contest (a blinded trial), newest first. Bubbles rise while judges are still out (received < expected); unsealed entries ride belt C as orbs while the result waits for your pick; the trophy shows once a pick is recorded. The file format: docs/contest-format.md.",
  "type": "object",
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "$ref": "#/$defs/state"
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "error": {
      "type": "string",
      "maxLength": 300
    },
    "num": {
      "type": [
        "string",
        "integer"
      ],
      "description": "Optional: the number on the building's name plate."
    },
    "updated": {
      "$ref": "#/$defs/time"
    },
    "needs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "sealed": {
            "type": "boolean"
          },
          "fill": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The liquid: the entry's score from 0 to 1."
          }
        }
      },
      "description": "The newest contest's entries, best first. An entry carries a name only once it is unsealed: none while the key is sealed, only the finalists at the pick step, all once a pick is recorded."
    },
    "judges": {
      "type": "object",
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "received": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "winner": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "The judges' first place: a code while sealed, else its name."
    },
    "pick": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "Your pick's name, 'None picked' for a decision that picks none, or null."
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "How many contests were found."
    },
    "contests": {
      "type": "array",
      "maxItems": 40,
      "description": "Every contest for the room (the bench and the crates), newest first.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "title",
          "state",
          "cards"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "state": {
            "$ref": "#/$defs/state"
          },
          "step": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "unblind",
              "pick",
              null
            ]
          },
          "say": {
            "type": "string",
            "maxLength": 200
          },
          "error": {
            "type": "string",
            "maxLength": 300
          },
          "stamp": {
            "$ref": "#/$defs/time"
          },
          "measure": {
            "type": "string",
            "enum": [
              "",
              "rank",
              "score",
              "r2wins"
            ]
          },
          "cards": {
            "type": "array",
            "maxItems": 120,
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "state": {
      "type": "string",
      "enum": [
        "ok",
        "waiting",
        "working",
        "error",
        "missing"
      ]
    },
    "time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Absolute ISO 8601 time with an offset; the page writes 'in 3 h' itself."
    },
    "need": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "href": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "href": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  }
}
