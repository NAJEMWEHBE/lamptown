{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamptown.invalid/schemas/rooms/ledger.schema.json",
  "title": "Lamptown room: ledger (vetting gate)",
  "description": "The two-signature register: one row per tool, closed by the scanner's verdict and the owner's recorded call. Rows in state 'working' are being scanned, 'waiting' rows wait for your call, 'error' rows are stopped at the gate; home-made tools with no scan stay grey ('missing').",
  "type": "object",
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "$ref": "#/$defs/state"
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "error": {
      "type": "string",
      "maxLength": 300
    },
    "num": {
      "type": [
        "string",
        "integer"
      ],
      "description": "Optional: the number on the building's name plate."
    },
    "updated": {
      "$ref": "#/$defs/time"
    },
    "needs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "state"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "maxLength": 120
          },
          "state": {
            "$ref": "#/$defs/state"
          },
          "result": {
            "type": "string",
            "maxLength": 300
          },
          "decision": {
            "type": [
              "object",
              "null"
            ],
            "description": "The owner's recorded call (from decisions_file), or null when none is recorded.",
            "properties": {
              "call": {
                "type": "string",
                "enum": [
                  "install",
                  "skip",
                  "park"
                ]
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "note": {
                "type": "string",
                "maxLength": 120
              },
              "source": {
                "type": "string",
                "maxLength": 300
              }
            }
          },
          "installed": {
            "type": "boolean"
          },
          "origin": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "scan": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "verdict": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 40
              },
              "risk": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "flags": {
                "type": [
                  "integer",
                  "array",
                  "null"
                ]
              },
              "when": {
                "$ref": "#/$defs/time"
              }
            }
          },
          "href": {
            "type": "string",
            "maxLength": 2048
          },
          "kind": {
            "type": "string",
            "enum": [
              "signed",
              "waiting",
              "scanning",
              "noscan",
              "unreadable",
              "skipped-in",
              "homemade",
              "norecord",
              "unscanned"
            ]
          },
          "when": {
            "$ref": "#/$defs/time"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "state": {
      "type": "string",
      "enum": [
        "ok",
        "waiting",
        "working",
        "error",
        "missing"
      ]
    },
    "time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Absolute ISO 8601 time with an offset; the page writes 'in 3 h' itself."
    },
    "need": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "href": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "href": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  }
}
