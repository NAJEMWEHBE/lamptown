#!/bin/sh
# Lamptown commit-msg hook for clones that use `git config core.hooksPath tools/hooks`:
# the privacy gate over the commit message and the author and committer identity.
# With pre-commit installed and .pre-commit-config.yaml present it runs pre-commit's
# commit-msg stage instead (the same check). git passes the message file as $1.
root=$(git rev-parse --show-toplevel) || exit 2
if [ -f "$root/.pre-commit-config.yaml" ] && command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --hook-stage commit-msg --commit-msg-filename "$1"
fi
for py in python3 python py; do
  if "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    exec "$py" "$root/tools/privacy_gate.py" --root "$root" --commit-msg "$1"
  fi
done
echo "commit-msg: Python 3.11+ not found, so the privacy gate could not run" >&2
exit 1
